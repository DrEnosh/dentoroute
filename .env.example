# ---- Required for LIVE mode (leave blank to run in Demo Mode) ----
TYPESAFE_API_KEY=
ANTHROPIC_API_KEY=

# ---- Optional ----
# auto  = live if TYPESAFE_API_KEY is set, otherwise Demo Mode (default)
# true  = always Demo Mode (simulated Jev responses, no API calls)
# false = always live (errors are shown if keys are missing)
DENTOROUTE_DEMO_MODE=auto

# Model names. jev-latest is the documented alias in the official TypeSafe docs.
JEV_MODEL=jev-latest
CLAUDE_MODEL=claude-sonnet-5-5

# Backend URL used by the Streamlit frontend (falls back to in-process if unreachable)
DENTOROUTE_API_URL=http://localhost:8000

# Optional: enable API cost estimates in the benchmark (USD per million tokens).
# Left blank, cost is reported as "not measured" rather than guessed.
CLAUDE_PRICE_INPUT_PER_MTOK=
CLAUDE_PRICE_OUTPUT_PER_MTOK=
JEV_PRICE_INPUT_PER_MTOK=
JEV_PRICE_OUTPUT_PER_MTOK=

# Benchmark concurrency for live runs
BENCHMARK_WORKERS=6
